# Copy to config.env and replace placeholders with your own paths.
# Never put game dumps, keys, firmware, DLLs, saves or personal folder names here.
# The published README/docs use placeholders only.

VICTORY_NERDJB_REPO=/path/to/your/VIctory-tree
VICTORY_NERDJB_GAME=/path/to/your/unpacked-title/game.exe
VICTORY_NERDJB_RUNTIME=/path/to/your/victory-build/victory.exe
VICTORY_NERDJB_PROTON=/path/to/your/GE-Proton11-14-ViewTree/proton

# Optional: leave unset to use the existing launcher's default prefix.
# VICTORY_PROTON_PREFIX=/path/to/your/proton-prefix
